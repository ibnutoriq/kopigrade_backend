# Secrets are read here and injected into the deploy.
# DO NOT put raw values here — this file is committed to git.
# Set these as actual environment variables in your shell before running kamal:
#
#   export KAMAL_REGISTRY_PASSWORD="your_dockerhub_access_token"
#   export DB_PASSWORD="a_strong_random_password"
#   export GOOGLE_API_KEY="your_gemini_api_key"
#
# Or add them to ~/.zshrc / ~/.bashrc so they persist.

RAILS_MASTER_KEY=$(cat config/master.key)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$DB_PASSWORD
KOPIGRADE_BACKEND_DATABASE_PASSWORD=$DB_PASSWORD
GOOGLE_API_KEY=$GOOGLE_API_KEY
