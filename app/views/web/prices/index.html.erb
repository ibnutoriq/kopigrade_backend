<div class="mb-6">
  <h1 class="text-xl font-bold text-stone-900 mb-1">Harga Kopi Hari Ini</h1>
  <p class="text-sm text-stone-600">Harga dari pasar Jawa Timur (Siskaperbapo Jatim).</p>
</div>

<div class="space-y-4">
  <% [["robusta", "Robusta", @robusta_price], ["arabika", "Arabika", @arabika_price]].each do |_key, label, price| %>
    <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-5">
      <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2"><%= label %></p>
      <% if price %>
        <p class="text-3xl font-bold text-stone-900">
          <%= number_to_currency(price.price, unit: "Rp", separator: ",", delimiter: ".", precision: 0) %><span class="text-lg font-normal text-stone-500">/kg</span>
        </p>
        <p class="text-sm text-stone-500 mt-1">
          per <%= l(price.price_date, format: :long) %>
        </p>
      <% else %>
        <p class="text-stone-400">Harga belum tersedia hari ini.</p>
      <% end %>
    </div>
  <% end %>
</div>

<div class="mt-6 text-center text-xs text-stone-400">
  Sumber: <a href="https://siskaperbapo.jatimprov.go.id" target="_blank" rel="noopener noreferrer" class="underline hover:text-stone-600">Siskaperbapo Jatim</a>
  &middot; Diperbarui setiap pagi pukul 06.00 WIB
</div>

<div class="mt-6">
  <%= link_to "← Kembali ke beranda", root_path, class: "text-sm text-amber-700 hover:text-amber-900" %>
</div>
