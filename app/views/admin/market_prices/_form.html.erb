<%= form_with model: [:admin, market_price], class: "space-y-5" do |f| %>
  <% if market_price.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
      <ul class="space-y-1">
        <% market_price.errors.full_messages.each do |msg| %>
          <li class="flex items-center gap-2">
            <span class="w-1 h-1 bg-red-400 rounded-full"></span><%= msg %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :variety, "Variety", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
    <%= f.select :variety, [["Robusta", "robusta"], ["Arabika", "arabika"]],
        {}, class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
  </div>

  <div>
    <%= f.label :price, "Price (Rp/kg)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
    <%= f.number_field :price, min: 1, placeholder: "e.g. 65000",
        class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
  </div>

  <div>
    <%= f.label :price_date, "Date", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
    <%= f.date_field :price_date,
        class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
  </div>

  <div>
    <%= f.label :source_url, "Source URL (optional)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
    <%= f.url_field :source_url, placeholder: "https://",
        class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
  </div>

  <%= f.submit "Save Price",
      class: "bg-amber-700 hover:bg-amber-800 text-white px-6 py-2.5 rounded-xl text-sm font-medium cursor-pointer transition-colors shadow-sm" %>
<% end %>
