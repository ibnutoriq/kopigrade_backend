<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Harga Pasar</h1>
  <div class="flex gap-3">
    <%= button_to "Scrape Sekarang", scrape_now_admin_market_prices_path, method: :post,
        class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded text-sm" %>
    <%= link_to "Tambah Harga", new_admin_market_price_path,
        class: "bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 rounded text-sm" %>
  </div>
</div>

<div class="bg-white rounded-xl shadow overflow-hidden">
  <% if @market_prices.empty? %>
    <p class="px-6 py-10 text-center text-gray-400">Belum ada data harga.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
        <tr>
          <th class="px-6 py-3 text-left">Varietas</th>
          <th class="px-6 py-3 text-left">Harga (Rp/kg)</th>
          <th class="px-6 py-3 text-left">Tanggal</th>
          <th class="px-6 py-3 text-left">Sumber</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @market_prices.each do |mp| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-3 capitalize font-medium"><%= mp.variety %></td>
            <td class="px-6 py-3 font-bold text-green-700">Rp <%= number_with_delimiter(mp.price) %></td>
            <td class="px-6 py-3"><%= mp.price_date.strftime("%d %b %Y") %></td>
            <td class="px-6 py-3 text-gray-400 text-xs"><%= mp.source_url&.truncate(40) || "—" %></td>
            <td class="px-6 py-3 flex gap-3">
              <%= link_to "Edit", edit_admin_market_price_path(mp), class: "text-amber-700 hover:underline text-xs" %>
              <%= button_to "Hapus", admin_market_price_path(mp), method: :delete,
                  data: { turbo_confirm: "Hapus data harga ini?" },
                  class: "text-red-500 hover:underline text-xs bg-transparent border-0 cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
