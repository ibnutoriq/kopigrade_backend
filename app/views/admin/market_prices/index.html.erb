<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-800">Market Prices</h1>
    <p class="text-xs text-slate-400 mt-0.5">Banyuwangi coffee commodity prices</p>
  </div>
  <div class="flex items-center gap-3">
    <%= button_to scrape_now_admin_market_prices_path, method: :post,
        class: "inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors shadow-sm" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      Scrape Now
    <% end %>
    <%= link_to "+ Add Price", new_admin_market_price_path,
        class: "inline-flex items-center gap-2 bg-amber-700 hover:bg-amber-800 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors shadow-sm" %>
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <% if @market_prices.empty? %>
    <div class="py-20 flex flex-col items-center text-slate-300">
      <svg class="w-12 h-12 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-sm font-medium text-slate-400">No price data yet</p>
      <p class="text-xs text-slate-300 mt-1">Click "Scrape Now" to fetch today's prices</p>
    </div>
  <% else %>
    <table class="w-full">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-100">
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Variety</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Price (Rp/kg)</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Date</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Source</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% @market_prices.each do |mp| %>
          <tr class="hover:bg-slate-50/60 transition-colors group">
            <td class="px-6 py-3.5">
              <span class="px-2.5 py-0.5 bg-amber-50 text-amber-800 text-xs font-medium rounded-full capitalize"><%= mp.variety %></span>
            </td>
            <td class="px-6 py-3.5">
              <span class="text-base font-bold text-emerald-700">Rp <%= number_with_delimiter(mp.price) %></span>
            </td>
            <td class="px-6 py-3.5 text-sm text-slate-600"><%= mp.price_date.strftime("%-d %B %Y") %></td>
            <td class="px-6 py-3.5 text-xs text-slate-400 max-w-48 truncate"><%= mp.source_url || "—" %></td>
            <td class="px-6 py-3.5">
              <div class="flex items-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                <%= link_to "Edit", edit_admin_market_price_path(mp), class: "text-xs font-medium text-amber-700 hover:text-amber-900" %>
                <%= button_to "Delete", admin_market_price_path(mp), method: :delete,
                    data: { turbo_confirm: "Delete this price entry?" },
                    class: "text-xs font-medium text-red-400 hover:text-red-600 bg-transparent border-0 cursor-pointer" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
