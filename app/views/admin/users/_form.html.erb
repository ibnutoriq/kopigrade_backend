<%= form_with model: [:admin, user], class: "space-y-5" do |f| %>
  <% if user.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
      <ul class="space-y-1">
        <% user.errors.full_messages.each do |msg| %>
          <li class="flex items-center gap-2">
            <span class="w-1 h-1 bg-red-400 rounded-full"></span><%= msg %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email_address, "Email address", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
    <%= f.email_field :email_address,
        class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
  </div>

  <div>
    <%= f.label :password, user.persisted? ? "New password (leave blank to keep current)" : "Password",
        class: "block text-sm font-medium text-slate-700 mb-1.5" %>
    <%= f.password_field :password, autocomplete: "new-password",
        class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
  </div>

  <% unless user.persisted? %>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
      <%= f.password_field :password_confirmation,
          class: "w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400" %>
    </div>
  <% end %>

  <div class="flex items-center gap-3 p-4 bg-amber-50 rounded-xl border border-amber-100">
    <%= f.check_box :admin, class: "h-4 w-4 text-amber-700 rounded border-amber-300" %>
    <div>
      <%= f.label :admin, "Administrator", class: "text-sm font-medium text-slate-700 cursor-pointer" %>
      <p class="text-xs text-slate-400">Can access all admin dashboard features</p>
    </div>
  </div>

  <%= f.submit user.persisted? ? "Save Changes" : "Create User",
      class: "bg-amber-700 hover:bg-amber-800 text-white px-6 py-2.5 rounded-xl text-sm font-medium cursor-pointer transition-colors shadow-sm" %>
<% end %>
