<%= form_with model: [:admin, user], class: "space-y-4" do |f| %>
  <% if user.errors.any? %>
    <div class="bg-red-50 text-red-700 p-3 rounded text-sm">
      <ul class="list-disc list-inside">
        <% user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email_address, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :password, user.persisted? ? "Password Baru (kosongkan jika tidak diubah)" : "Password",
        class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password, autocomplete: "new-password",
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
  </div>
  <% if !user.persisted? %>
    <div>
      <%= f.label :password_confirmation, "Konfirmasi Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
  <% end %>
  <div class="flex items-center gap-2">
    <%= f.check_box :admin, class: "h-4 w-4 text-amber-700" %>
    <%= f.label :admin, "Admin", class: "text-sm font-medium text-gray-700" %>
  </div>
  <%= f.submit "Simpan", class: "bg-amber-700 hover:bg-amber-600 text-white px-6 py-2 rounded cursor-pointer" %>
<% end %>
