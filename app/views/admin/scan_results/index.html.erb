<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-800">Scan Results</h1>
    <p class="text-xs text-slate-400 mt-0.5">All coffee bean scan submissions</p>
  </div>
  <%= link_to "↓ Export CSV", admin_export_scan_results_path(format: :csv),
      class: "inline-flex items-center gap-2 bg-amber-700 hover:bg-amber-800 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors shadow-sm" %>
</div>

<%# Filters %>
<%= form_with url: admin_scan_results_path, method: :get,
              data: { turbo_frame: "scan_results_table" },
              class: "bg-white rounded-2xl border border-slate-100 shadow-sm p-4 mb-6 flex flex-wrap items-center gap-3" do |f| %>
  <div class="flex items-center gap-2">
    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
    </svg>
    <span class="text-sm font-medium text-slate-500">Filter</span>
  </div>

  <%= f.select :sub_district,
       options_for_select([["All Sub-Districts", ""]] + ScanResult.distinct.pluck(:sub_district).compact.sort.map { |s| [s, s] }, params[:sub_district]),
       {}, class: "border border-slate-200 rounded-lg px-3 py-1.5 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20" %>

  <%= f.select :status,
       options_for_select([["All Statuses", ""], ["Pending", "pending"], ["Analyzed", "analyzed"], ["Failed", "failed"]], params[:status]),
       {}, class: "border border-slate-200 rounded-lg px-3 py-1.5 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20" %>

  <%= f.select :sni_grade,
       options_for_select([["All Grades", ""]] + %w[Mutu\ 1 Mutu\ 2 Mutu\ 3 Mutu\ 4a Mutu\ 4b Mutu\ 4 Mutu\ 5 Mutu\ 6].map { |g| [g, g] }, params[:sni_grade]),
       {}, class: "border border-slate-200 rounded-lg px-3 py-1.5 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20" %>

  <div class="flex items-center gap-2">
    <%= f.date_field :from, value: params[:from], placeholder: "From", class: "border border-slate-200 rounded-lg px-3 py-1.5 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20" %>
    <span class="text-slate-300">→</span>
    <%= f.date_field :to, value: params[:to], placeholder: "To", class: "border border-slate-200 rounded-lg px-3 py-1.5 text-sm text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20" %>
  </div>

  <%= f.submit "Apply", class: "bg-amber-700 hover:bg-amber-800 text-white px-4 py-1.5 rounded-lg text-sm font-medium cursor-pointer transition-colors" %>
  <%= link_to "Reset", admin_scan_results_path, class: "text-sm text-slate-400 hover:text-slate-600 transition-colors" %>
<% end %>

<turbo-frame id="scan_results_table">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <% if @scan_results.empty? %>
      <div class="py-20 flex flex-col items-center text-slate-300">
        <svg class="w-12 h-12 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <p class="text-sm font-medium text-slate-400">No scan results found</p>
        <p class="text-xs text-slate-300 mt-1">Try adjusting your filters</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">ID</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Device</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Sub-District</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Variety</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Beans</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">SNI Grade</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Export</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Status</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wide">Date</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% @scan_results.each do |scan| %>
              <tr class="hover:bg-slate-50/60 transition-colors group">
                <td class="px-5 py-3.5 text-xs font-mono text-slate-400">#<%= scan.id %></td>
                <td class="px-5 py-3.5 text-xs font-mono text-slate-400 max-w-20 truncate"><%= scan.device_id&.truncate(8) || "—" %></td>
                <td class="px-5 py-3.5 text-sm font-medium text-slate-700"><%= scan.sub_district || "—" %></td>
                <td class="px-5 py-3.5">
                  <span class="px-2 py-0.5 bg-amber-50 text-amber-700 text-xs font-medium rounded-full capitalize"><%= scan.variety %></span>
                </td>
                <td class="px-5 py-3.5 text-sm text-slate-600"><%= scan.total_beans %></td>
                <td class="px-5 py-3.5">
                  <% if scan.sni_grade.present? %>
                    <span class="text-sm font-bold text-amber-800"><%= scan.sni_grade %></span>
                  <% else %>
                    <span class="text-slate-300">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5">
                  <% if scan.export_eligible? %>
                    <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 text-xs font-medium rounded-full">Yes</span>
                  <% elsif scan.export_eligible == false %>
                    <span class="px-2 py-0.5 bg-red-50 text-red-600 text-xs font-medium rounded-full">No</span>
                  <% else %>
                    <span class="text-slate-300 text-sm">—</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold
                    <%= scan.pending?  ? 'bg-yellow-100 text-yellow-800' :
                        scan.analyzed? ? 'bg-emerald-100 text-emerald-800' :
                                         'bg-red-100 text-red-700' %>">
                    <%= scan.status.capitalize %>
                  </span>
                </td>
                <td class="px-5 py-3.5 text-xs text-slate-400"><%= scan.created_at.strftime("%-d %b %Y") %></td>
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                    <%= link_to "View", admin_scan_result_path(scan), class: "text-xs font-medium text-amber-700 hover:text-amber-900" %>
                    <%= button_to "Delete", admin_scan_result_path(scan), method: :delete,
                        data: { turbo_confirm: "Delete this scan result?" },
                        class: "text-xs font-medium text-red-400 hover:text-red-600 bg-transparent border-0 cursor-pointer" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</turbo-frame>
