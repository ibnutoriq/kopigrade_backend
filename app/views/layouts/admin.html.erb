<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KopiGrade Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-slate-50 antialiased">
    <div class="flex h-full">

      <%# ── Sidebar ──────────────────────────────────────────────────── %>
      <aside class="w-64 shrink-0 bg-amber-950 flex flex-col fixed inset-y-0 shadow-2xl z-30">

        <%# Brand %>
        <div class="flex items-center gap-3 px-6 py-5 border-b border-amber-900/60">
          <div class="w-9 h-9 bg-amber-400 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-5 h-5 text-amber-950" fill="currentColor" viewBox="0 0 24 24">
              <path d="M2 21v-2h2V3h14v2h2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2v6h2v2H2zm4-10h8V5H6v6zm10 0h2V7h-2v4z"/>
            </svg>
          </div>
          <div>
            <p class="text-white font-bold text-base leading-tight tracking-wide">KopiGrade</p>
            <p class="text-amber-400 text-xs font-medium">Banyuwangi</p>
          </div>
        </div>

        <%# Navigation %>
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
          <p class="px-3 mb-2 text-amber-500/70 text-xs font-semibold uppercase tracking-widest">Main</p>

          <%= link_to admin_dashboard_path,
                class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all group
                        #{request.path == admin_dashboard_path ? 'bg-amber-400 text-amber-950' : 'text-amber-200 hover:bg-amber-900 hover:text-white'}" do %>
            <svg class="w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Dashboard
          <% end %>

          <p class="px-3 pt-4 mb-2 text-amber-500/70 text-xs font-semibold uppercase tracking-widest">Data</p>

          <%= link_to admin_scan_results_path,
                class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
                        #{request.path.start_with?(admin_scan_results_path) ? 'bg-amber-400 text-amber-950' : 'text-amber-200 hover:bg-amber-900 hover:text-white'}" do %>
            <svg class="w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            Scan Results
          <% end %>

          <%= link_to admin_market_prices_path,
                class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
                        #{request.path.start_with?(admin_market_prices_path) ? 'bg-amber-400 text-amber-950' : 'text-amber-200 hover:bg-amber-900 hover:text-white'}" do %>
            <svg class="w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Market Prices
          <% end %>

          <p class="px-3 pt-4 mb-2 text-amber-500/70 text-xs font-semibold uppercase tracking-widest">Admin</p>

          <%= link_to admin_users_path,
                class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all
                        #{request.path.start_with?(admin_users_path) ? 'bg-amber-400 text-amber-950' : 'text-amber-200 hover:bg-amber-900 hover:text-white'}" do %>
            <svg class="w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            Users
          <% end %>
        </nav>

        <%# User section %>
        <div class="px-4 py-4 border-t border-amber-900/60">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 bg-amber-700 rounded-full flex items-center justify-center shrink-0">
              <span class="text-amber-100 text-xs font-bold"><%= Current.user&.email_address&.first&.upcase %></span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white text-xs font-medium truncate"><%= Current.user&.email_address %></p>
              <p class="text-amber-400 text-xs">Administrator</p>
            </div>
          </div>
          <%= button_to "Sign out", session_path, method: :delete,
              class: "w-full flex items-center justify-center gap-2 text-amber-300 hover:text-white hover:bg-amber-900 text-xs py-2 px-3 rounded-lg transition-all" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Sign out
          <% end %>
        </div>
      </aside>

      <%# ── Main content ────────────────────────────────────────────── %>
      <div class="ml-64 flex-1 flex flex-col min-h-full">

        <%# Top bar %>
        <header class="sticky top-0 z-20 bg-white/80 backdrop-blur-sm border-b border-slate-200 px-8 py-4 flex items-center justify-between">
          <div>
            <h1 class="text-lg font-semibold text-slate-800"><%= content_for(:page_title) { "Dashboard" } %></h1>
            <p class="text-xs text-slate-400 mt-0.5">Banyuwangi Coffee Quality System</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
            <span class="text-xs text-slate-500">Live</span>
          </div>
        </header>

        <%# Flash messages %>
        <% if notice.present? %>
          <div class="mx-8 mt-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="mx-8 mt-4 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm flex items-center gap-2">
            <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= alert %>
          </div>
        <% end %>

        <%# Page content %>
        <main class="flex-1 px-8 py-6">
          <%= yield %>
        </main>

        <footer class="px-8 py-4 border-t border-slate-100 text-center text-xs text-slate-400">
          KopiGrade &copy; <%= Date.current.year %> &middot; Banyuwangi, East Java
        </footer>
      </div>

    </div>
  </body>
</html>
